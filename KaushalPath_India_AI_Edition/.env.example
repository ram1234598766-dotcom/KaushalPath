# Optional. Leave blank to use the offline starter notes only.
# Keep this key private and set it in your terminal environment, not in JavaScript.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Enable live web search restricted to official CBSE/NCERT domains for source-assisted notes.
# Search runs only when OPENAI_API_KEY is configured. Set to 0 to disable web search.
OPENAI_WEB_SEARCH=1
OPENAI_MAX_OUTPUT_TOKENS=2600
